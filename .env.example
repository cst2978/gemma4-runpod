# ---------------------------------------------------------------------------
# RunPod endpoint environment variables for gemma-4-26B-A4B-it (vLLM).
# Copy the values you need into the RunPod endpoint's "Environment Variables"
# section in the console. Do NOT commit real secrets — keep them in .env only.
# ---------------------------------------------------------------------------

# Model + serving config (read by handler.py)
MODEL_NAME=google/gemma-4-26B-A4B-it
MAX_MODEL_LEN=32768
DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.95
TENSOR_PARALLEL_SIZE=1

# Only needed if the model becomes gated on HuggingFace (it is Apache-2.0 / open
# today). Create at https://huggingface.co/settings/tokens
# HUGGING_FACE_HUB_TOKEN=hf_xxx

# ---------------------------------------------------------------------------
# For calling the deployed endpoint from test_request.py (local only):
# ---------------------------------------------------------------------------
# Your RunPod API key (same one used for the MCP server).
RUNPOD_API_KEY=rpa_xxx
# The endpoint ID RunPod gives you after the endpoint is created.
RUNPOD_ENDPOINT_ID=xxxxxxxxxxxx
